{
  "Logging": { "LogLevel": { "Default": "Information", "Yarp": "Information" } },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "basket": {
        "ClusterId": "basket",
        "Order": 1,
        "Match": { "Path": "/api/basket/{**catch-all}" }
      },
      "basket-exact": {
        "ClusterId": "basket",
        "Order": 1,
        "Match": { "Path": "/api/basket" }
      },
      "monolith": {
        "ClusterId": "api",
        "Order": 100,
        "Match": { "Path": "/{**catch-all}" }
      }
    },
    "Clusters": {
      "basket": { "Destinations": { "d1": { "Address": "http://basket/" } } },
      "api": { "Destinations": { "d1": { "Address": "http://api/" } } }
    }
  }
}
